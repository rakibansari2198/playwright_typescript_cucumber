{
  "name": "playwright-cucumber-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright TypeScript Cucumber BDD Framework",
  "main": "index.js",
  "scripts": {
    "test:Headless": "cross-env HEADLESS=true cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:qa": "cross-env ENV=qa cucumber-js",
    "test:uat": "cross-env ENV=uat cucumber-js",
    "chrome": "cross-env BROWSER=chromium HEADLESS=false cucumber-js",
    "firefox": "cross-env BROWSER=firefox HEADLESS=false cucumber-js",
    "webkit": "cross-env BROWSER=webkit HEADLESS=false cucumber-js",
    "parallel-chrome": "cross-env BROWSER=chromium HEADLESS=true cucumber-js --parallel 4",
    "parallel-firefox": "cross-env BROWSER=firefox HEADLESS=true cucumber-js --parallel 4",
    "parallel-webkit": "cross-env BROWSER=webkit HEADLESS=true cucumber-js --parallel 4",
    "cross-browser": "npm-run-all --parallel parallel-chrome parallel-firefox parallel-webkit",
    "smoke": "cucumber-js --tags \"@smoke\"",
    "regression": "cucumber-js --tags \"@regression\"",
    "report": "node report.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@playwright/test": "^1.42.0",
    "@types/node": "^20.11.0",
    "cross-env": "^7.0.3",
    "multiple-cucumber-html-reporter": "^3.6.0",
    "npm-run-all": "^4.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mysql2": "^3.9.2",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  }
}
